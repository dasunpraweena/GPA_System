# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gpa_system_db

# CORS Configuration
CLIENT_ORIGIN=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Email Service (Optional: leave empty to log verification & reset links to server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Semester GPA System <noreply@ms.sab.ac.lk>"

# File Uploads Directory
UPLOAD_DIR=uploads
